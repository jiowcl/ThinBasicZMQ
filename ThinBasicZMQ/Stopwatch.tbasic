USES "CONSOLE"

#INCLUDE Once ".\Core\ZeroMQ.inc"

Global hWatch As Long
Global elapsed As DWord

hWatch = ZmqStopwatchStart()
ZmqSleep(1)
elapsed = ZmqStopwatchIntermediate(hWatch)
Printl("Intermediate (us): " & elapsed)

ZmqSleep(1)
elapsed = ZmqStopwatchStop(hWatch)
Printl("Total (us): " & elapsed)

Console_Read()