' SDK PUB/SUB subscriber. Start ZmqSdkPubServer.tbasic first.
' Prerequisite: copy SDK\C\bin\thinBasic_ZeroMQ.dll to C:\thinBasic\Lib\

USES "CONSOLE"
USES "ZeroMQ"

Global lpszLibPath As String
Global lpszServerAddr As String
Global lpszSubscribe As String
Global hContext As Long
Global hSocket As Long
Global Rc As Long
Global TopicBytes As Long
Global MessageBytes As Long
Global lpszTopicBuffer As String * 256
Global lpszRecvBuffer As String * 256

lpszLibPath = APP_SourcePath & "..\..\..\ThinBasicZMQ\Library\x86"
lpszServerAddr = "tcp://127.0.0.1:1741"
lpszSubscribe = "quotes"

If ZmqLibraryInit(lpszLibPath) = 0 Then
  Printl("Failed to load libzmq from " & lpszLibPath)
  Console_Read()
  Stop
End If

hContext = ZmqCtxNew()
hSocket = ZmqSocket(hContext, %ZMQ_SUB)
ZmqSetsockoptInt(hSocket, %ZMQ_LINGER, 0)

' Subscribe before connect to reduce missed early messages.
Rc = ZmqSetsockoptStr(hSocket, %ZMQ_SUBSCRIBE, lpszSubscribe)

If Rc <> 0 Then
  Printl("Subscribe failed: " & ZmqStrerrorString(ZmqErrno()))
Else
  Rc = ZmqConnect(hSocket, lpszServerAddr)

  If Rc <> 0 Then
    Printl("Connect failed: " & ZmqStrerrorString(ZmqErrno()))
  Else
    Printl("Connected: " & lpszServerAddr & " (subscribe=" & lpszSubscribe & ")")

    While %TRUE
      TopicBytes = ZmqRecv(hSocket, StrPtr(lpszTopicBuffer), 256, 0)

      If TopicBytes = -1 Then
        Printl("Recv topic failed: " & ZmqStrerrorString(ZmqErrno()))
      Else
        MessageBytes = ZmqRecv(hSocket, StrPtr(lpszRecvBuffer), 256, 0)

        If MessageBytes = -1 Then
          Printl("Recv message failed: " & ZmqStrerrorString(ZmqErrno()))
        ElseIf MessageBytes > 0 Then
          Printl(Left$(lpszRecvBuffer, MessageBytes))
        End If
      End If
    Wend
  End If
End If

ZmqClose(hSocket)
ZmqCtxShutdown(hContext)
ZmqLibraryShutdown()
Console_Read()
