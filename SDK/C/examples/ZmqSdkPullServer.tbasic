' SDK PUSH/PULL sink. Run this first, then ZmqSdkPushClient.tbasic.
' Prerequisite: copy SDK\C\bin\thinBasic_ZeroMQ.dll to C:\thinBasic\Lib\

USES "CONSOLE"
USES "ZeroMQ"

Global lpszLibPath As String
Global lpszServerAddr As String
Global hContext As Long
Global hSocket As Long
Global Rc As Long
Global lTotal As Long
Global lpszRecv As String

lpszLibPath = APP_SourcePath & "..\..\..\ThinBasicZMQ\Library\x86"
lpszServerAddr = "tcp://*:1743"

If ZmqLibraryInit(lpszLibPath) = 0 Then
  Printl("Failed to load libzmq from " & lpszLibPath)
  Console_Read()
  Stop
End If

hContext = ZmqCtxNew()
hSocket = ZmqSocket(hContext, %ZMQ_PULL)
ZmqSetsockoptInt(hSocket, %ZMQ_LINGER, 0)
Rc = ZmqBind(hSocket, lpszServerAddr)

If Rc <> 0 Then
  Printl("Bind failed: " & ZmqStrerrorString(ZmqErrno()))
Else
  Printl("Bind an IP address: " & lpszServerAddr)

  lTotal = 0

  While %TRUE
    lpszRecv = ZmqRecvStr(hSocket, 64, 0)

    If Len(lpszRecv) > 0 Then
      lTotal = lTotal + 1
      Printl("Pulled #" & lTotal & ": " & lpszRecv)
    End If
  Wend
End If

ZmqUnbind(hSocket, lpszServerAddr)
ZmqClose(hSocket)
ZmqCtxShutdown(hContext)
ZmqLibraryShutdown()
