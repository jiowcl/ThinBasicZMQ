' SDK REQ/REP client. Start ZmqSdkRepServer.tbasic first.
' Prerequisite: copy SDK\C\bin\thinBasic_ZeroMQ.dll to C:\thinBasic\Lib\

USES "CONSOLE"
USES "ZeroMQ"

Global lpszLibPath As String
Global lpszServerAddr As String
Global hContext As Long
Global hSocket As Long
Global Rc As Long
Global i As Long
Global nRecvBytes As Long
Global lpszSendMessage As String
Global lpszRecvBuffer As String * 32

lpszLibPath = APP_SourcePath & "..\..\..\ThinBasicZMQ\Library\x86"
lpszServerAddr = "tcp://127.0.0.1:1740"

If ZmqLibraryInit(lpszLibPath) = 0 Then
  Printl("Failed to load libzmq from " & lpszLibPath)
  Console_Read()
  Stop
End If

hContext = ZmqCtxNew()
hSocket = ZmqSocket(hContext, %ZMQ_REQ)
ZmqSetsockoptInt(hSocket, %ZMQ_LINGER, 0)
Rc = ZmqConnect(hSocket, lpszServerAddr)

If Rc <> 0 Then
  Printl("Connect failed, errno=" & ZmqErrno())
Else
  Printl("Connect to Server: " & lpszServerAddr)
  Sleep 50

  For i = 0 To 10
    lpszSendMessage = "From SDK Client"
    ZmqSend(hSocket, StrPtr(lpszSendMessage), Len(lpszSendMessage), 0)
    nRecvBytes = ZmqRecv(hSocket, StrPtr(lpszRecvBuffer), 32, 0)

    If nRecvBytes > 0 Then
      Printl("Reply From Server: " & Left$(lpszRecvBuffer, nRecvBytes))
    End If
  Next
End If

ZmqClose(hSocket)
ZmqCtxShutdown(hContext)
ZmqLibraryShutdown()
Printl("Completed!")
Console_Read()
