' SDK PUB/SUB publisher. Run this first, then ZmqSdkSubClient.tbasic.
' Prerequisite: copy SDK\C\bin\thinBasic_ZeroMQ.dll to C:\thinBasic\Lib\

USES "CONSOLE"
USES "ZeroMQ"

Global lpszLibPath As String
Global lpszServerAddr As String
Global hContext As Long
Global hSocket As Long
Global Rc As Long
Global lpszTopic As String
Global lpszSendMessage As String
Global nBid As Long
Global nAsk As Long

Function RndRange(ByVal first As Double, ByVal last As Double) As Double
  Function = Rnd * (last - first) + first
End Function

lpszLibPath = APP_SourcePath & "..\..\..\ThinBasicZMQ\Library\x86"
lpszServerAddr = "tcp://*:1741"

If ZmqLibraryInit(lpszLibPath) = 0 Then
  Printl("Failed to load libzmq from " & lpszLibPath)
  Console_Read()
  Stop
End If

hContext = ZmqCtxNew()
hSocket = ZmqSocket(hContext, %ZMQ_PUB)
ZmqSetsockoptInt(hSocket, %ZMQ_LINGER, 0)
Rc = ZmqBind(hSocket, lpszServerAddr)

If Rc <> 0 Then
  Printl("Bind failed: " & ZmqStrerrorString(ZmqErrno()))
Else
  Printl("Bind an IP address: " & lpszServerAddr)

  ' Allow subscribers time to connect (slow joiner).
  Sleep 200
  Randomize

  While %TRUE
    lpszTopic = "quotes"
    nBid = Int(RndRange(1000, 9000))
    nAsk = Int(RndRange(1000, 9000))
    lpszSendMessage = "Bid:" & Str$(nBid) & ",Ask:" & Str$(nAsk)

    If ZmqSendStr(hSocket, lpszTopic, %ZMQ_SNDMORE) = -1 Then
      Printl("Send topic failed: " & ZmqStrerrorString(ZmqErrno()))
    ElseIf ZmqSendStr(hSocket, lpszSendMessage, 0) = -1 Then
      Printl("Send message failed: " & ZmqStrerrorString(ZmqErrno()))
    Else
      Printl("Published: " & lpszSendMessage)
    End If

    Sleep 100
  Wend
End If

ZmqClose(hSocket)
ZmqCtxShutdown(hContext)
ZmqLibraryShutdown()
