' Minimal multipart example for the ThinBasic SDK module.
' Demonstrates:
'   - frame 1: ZmqSendStr(..., 2 /* %ZMQ_SNDMORE */)
'   - frame 2: ZmqSendStr(..., 0)
'   - receive: ZmqGetsockoptInt(..., 13 /* %ZMQ_RCVMORE */) controls how many frames to read
'
' Prerequisite:
'   copy SDK\C\bin\thinBasic_ZeroMQ.dll to C:\thinBasic\Lib\
'
' Note:
'   This is single-process REQ/REP (sequential send/recv, no poll).

USES "CONSOLE"
USES "ZeroMQ"

Global lpszLibPath As String
Global hContext As Long
Global hSocketRep As Long
Global hSocketReq As Long
Global lpszServerAddr As String

Global lpszFrame1 As String
Global lpszFrame2 As String
Global lpszReply1 As String
Global lpszReply2 As String
Global lpszRecv1 As String
Global lpszRecv2 As String

Global Rc As Long
Global rcvm As Long
Global nRc As Long

lpszLibPath = APP_SourcePath & "..\..\..\ThinBasicZMQ\Library\x86"
lpszServerAddr = "tcp://127.0.0.1:1751"

Rc = ZmqLibraryInit(lpszLibPath)
If Rc = 0 Then
  Printl("Failed to load libzmq from " & lpszLibPath)
  Printl("errno: " & ZmqErrno() & " (" & ZmqStrerrorString(ZmqErrno()) & ")")
  Console_Read()
  Stop
End If

hContext = ZmqCtxNew()
hSocketRep = ZmqSocket(hContext, %ZMQ_REP)
hSocketReq = ZmqSocket(hContext, %ZMQ_REQ)

ZmqSetsockoptInt(hSocketRep, %ZMQ_LINGER, 0)
ZmqSetsockoptInt(hSocketReq, %ZMQ_LINGER, 0)

ZmqBind(hSocketRep, lpszServerAddr)
ZmqConnect(hSocketReq, lpszServerAddr)
Sleep 50

' Client -> Server (2 frames)
lpszFrame1 = "frame-1"
lpszFrame2 = "frame-2"

ZmqSendStr(hSocketReq, lpszFrame1, 2)
Rc = ZmqSendStr(hSocketReq, lpszFrame2, 0)
If Rc = -1 Then
  Printl("Client send frame2 failed: " & ZmqStrerrorString(ZmqErrno()))
  Stop
End If

' Server receive first frame
lpszRecv1 = ZmqRecvStr(hSocketRep, 256, 0)
rcvm = ZmqGetsockoptInt(hSocketRep, 13)

' Server receive second frame only if multipart continues
If rcvm <> 0 Then
  lpszRecv2 = ZmqRecvStr(hSocketRep, 256, 0)
Else
  lpszRecv2 = ""
End If

If Len(lpszRecv1) = 0 Then
  Printl("Server recv frame1 failed or empty: " & ZmqStrerrorString(ZmqErrno()))
End If

Printl("Server got: [" & lpszRecv1 & "], [" & lpszRecv2 & "]")

' Server -> Client reply (2 frames)
lpszReply1 = "reply-1"
lpszReply2 = "reply-2"

ZmqSendStr(hSocketRep, lpszReply1, 2)
Rc = ZmqSendStr(hSocketRep, lpszReply2, 0)
If Rc = -1 Then
  Printl("Server send frame2 failed: " & ZmqStrerrorString(ZmqErrno()))
  Stop
End If

' Client receive first frame
lpszRecv1 = ZmqRecvStr(hSocketReq, 256, 0)
rcvm = ZmqGetsockoptInt(hSocketReq, 13)

' Client receive second frame only if multipart continues
If rcvm <> 0 Then
  lpszRecv2 = ZmqRecvStr(hSocketReq, 256, 0)
Else
  lpszRecv2 = ""
End If

Printl("Client got reply: [" & lpszRecv1 & "], [" & lpszRecv2 & "]")

ZmqClose(hSocketReq)
ZmqClose(hSocketRep)
ZmqCtxShutdown(hContext)
ZmqLibraryShutdown()

Printl("Completed!")
Console_Read()

